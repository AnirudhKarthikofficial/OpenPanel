#!/bin/bash
# =========================================================
# JTG Developer Panel & Podman Environment Initializer (dev.jtg)
# Standalone Developer Panel Installation on Port 3000
# =========================================================

set -e

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

echo -e "${BLUE}${BOLD}"
echo "========================================================"
echo "      JTG DEVELOPER PANEL & PODMAN SETUP (dev.jtg)      "
echo "               Running on Port: 3000                    "
echo "========================================================"
echo -e "${NC}"

# Check and install Podman / Docker environment
echo -e "${BLUE}[JTG DEV] Checking container engine (Podman / Docker)...${NC}"
if command -v podman &> /dev/null; then
    echo -e "${GREEN}[JTG DEV] Podman is installed and active.${NC}"
elif command -v docker &> /dev/null; then
    echo -e "${GREEN}[JTG DEV] Docker engine detected.${NC}"
else
    echo -e "${YELLOW}[JTG DEV] Installing Podman engine...${NC}"
    if command -v apt-get &> /dev/null; then
        sudo apt-get update -y && sudo apt-get install -y podman || true
    elif command -v yum &> /dev/null; then
        sudo yum install -y podman || true
    fi
fi

# Rootless Podman environment variables
export PODMAN_USERNS=keep-id
export PODMAN_ROOTLESS=1

# Ensure Node.js is ready
if ! command -v node &> /dev/null; then
    echo -e "${YELLOW}[JTG DEV] Node.js not detected. Installing Node.js...${NC}"
    curl -fsSL https://deb.nodesource.com/setup_22.x | sudo -E bash - 2>/dev/null || true
    sudo apt-get install -y nodejs 2>/dev/null || true
fi

# Configure .env for Developer Panel on Port 3000
echo -e "${BLUE}[JTG DEV] Setting up environment variables in .env...${NC}"
if [ -f ".env" ]; then
    if ! grep -q "VITE_ENABLE_DEVELOPER_PANEL" .env; then
        echo "VITE_ENABLE_DEVELOPER_PANEL=true" >> .env
    else
        sed -i 's/VITE_ENABLE_DEVELOPER_PANEL=.*/VITE_ENABLE_DEVELOPER_PANEL=true/g' .env 2>/dev/null || true
    fi
    if ! grep -q "DEV_PORT" .env; then
        echo "DEV_PORT=3000" >> .env
    fi
else
    echo "PORT=3000" > .env
    echo "DEV_PORT=3000" >> .env
    echo "VITE_ENABLE_DEVELOPER_PANEL=true" >> .env
    echo "JWT_SECRET=$(head -c 32 /dev/urandom | base64)" >> .env
fi

# Create separate PM2 config for Dev Panel if needed
if [ ! -f "ecosystem.dev.cjs" ]; then
    echo -e "${BLUE}[JTG DEV] Creating PM2 ecosystem config for Developer Panel...${NC}"
cat << 'EOF' > ecosystem.dev.cjs
module.exports = {
  apps: [
    {
      name: "jtg-dev-panel",
      script: "npm",
      args: "run dev",
      instances: 1,
      autorestart: true,
      watch: false,
      max_memory_restart: "1G",
      env: {
        NODE_ENV: "development",
        PORT: 3000,
        VITE_ENABLE_DEVELOPER_PANEL: "true"
      }
    }
  ]
};
EOF
fi

# Install dependencies if needed
if [ -f "package.json" ]; then
    echo -e "${BLUE}[JTG DEV] Checking Node dependencies...${NC}"
    npm i --quiet || true
    
    echo -e "${BLUE}[JTG DEV] Building Developer Panel assets...${NC}"
    npm run build || true
fi

# Start separate PM2 process for Developer Panel
if command -v pm2 &> /dev/null || npx pm2 -v &> /dev/null; then
    echo -e "${BLUE}[JTG DEV] Starting Developer Panel on Port 3000 via PM2...${NC}"
    npx pm2 start ecosystem.dev.cjs 2>/dev/null || npx pm2 restart jtg-dev-panel 2>/dev/null || true
    npx pm2 save || true
fi

echo -e "${GREEN}${BOLD}"
echo "========================================================"
echo " [SUCCESS] Developer Panel successfully initialized!"
echo " Separate PM2 process: jtg-dev-panel"
echo " Access URL: http://<YOUR-SERVER-IP>:3000/developer"
echo " Podman & Docker support activated."
echo "========================================================"
echo -e "${NC}"
