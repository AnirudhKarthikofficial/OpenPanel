#!/bin/bash
# =========================================================
# JTG Developer Panel & Podman Environment Initializer (dev.jtg)
# =========================================================

set -e

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

echo -e "${BLUE}[JTG DEV] Initializing Developer Panel & Podman Environment...${NC}"

# Check Podman / Docker environment
if command -v podman &> /dev/null; then
    echo -e "${GREEN}[JTG DEV] Podman runtime detected.${NC}"
else
    echo -e "${YELLOW}[JTG DEV] Podman not found. Checking Docker...${NC}"
    if command -v docker &> /dev/null; then
        echo -e "${GREEN}[JTG DEV] Docker engine available for container creation.${NC}"
    else
        echo -e "${YELLOW}[JTG DEV] Attempting automatic Podman installation...${NC}"
        if command -v apt-get &> /dev/null; then
            sudo apt-get update -y && sudo apt-get install -y podman || true
        elif command -v yum &> /dev/null; then
            sudo yum install -y podman || true
        fi
    fi
fi

# Configure .env file for Developer Panel on Port 3000
if [ -f ".env" ]; then
    if ! grep -q "VITE_ENABLE_DEVELOPER_PANEL" .env; then
        echo "VITE_ENABLE_DEVELOPER_PANEL=true" >> .env
    else
        sed -i 's/VITE_ENABLE_DEVELOPER_PANEL=.*/VITE_ENABLE_DEVELOPER_PANEL=true/g' .env 2>/dev/null || true
    fi
else
    echo "PORT=3000" > .env
    echo "DEV_PORT=3000" >> .env
    echo "VITE_ENABLE_DEVELOPER_PANEL=true" >> .env
    echo "JWT_SECRET=$(head -c 32 /dev/urandom | base64)" >> .env
fi

# Configure Rootless Podman & Docker environment variables
export PODMAN_USERNS=keep-id
export PODMAN_ROOTLESS=1

echo -e "${GREEN}[JTG DEV] Developer panel configuration updated in .env.${NC}"
echo -e "${BLUE}[JTG DEV] Port 3000 & Podman mode enabled!${NC}"
echo -e "${GREEN}[SUCCESS] Developer Panel initialized in dev.jtg!${NC}"
